<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Utilities.Mobile.ManualReadingPage"
             Title="New reading"
             BackgroundColor="{AppThemeBinding Light=#F7F6FA, Dark=#17151E}">
    <VerticalStackLayout Padding="20" Spacing="18" VerticalOptions="Start">
        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252330}"
                Stroke="{AppThemeBinding Light=#EAE7F0, Dark=#3C3947}" StrokeThickness="1"
                StrokeShape="RoundRectangle 18" Padding="16">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding MeterTitle}" FontSize="18" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#272333, Dark=#F4F1FA}" />
                <Label x:Name="PreviousReadingLabel" FontSize="14"
                       TextColor="{AppThemeBinding Light=#777282, Dark=#B6B1C0}" />
            </VerticalStackLayout>
        </Border>

        <Entry x:Name="ReadingEntry" Placeholder="{Binding CurrentReadingPlaceholder}"
               Keyboard="Numeric" ReturnType="Done" ClearButtonVisibility="WhileEditing"
               FontSize="20" Text="{Binding ReadingValue, Mode=TwoWay}"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#252330}"
               TextColor="{AppThemeBinding Light=#272333, Dark=#F4F1FA}" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button ImageSource="ic_save.svg" SemanticProperties.Description="{Binding SaveText}"
                    Clicked="SaveClicked" Style="{StaticResource PrimaryActionButton}" HeightRequest="52" />
            <Button Grid.Column="1" ImageSource="ic_back.svg" SemanticProperties.Description="{Binding CancelText}"
                    Clicked="CancelClicked" Style="{StaticResource SecondaryActionButton}" HeightRequest="52" />
        </Grid>
    </VerticalStackLayout>
</ContentPage>
