<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Utilities.Mobile.ViewModels"
             x:Class="Utilities.Mobile.ReminderEditorPage"
             x:DataType="viewModels:ReminderEditorViewModel"
             BackgroundColor="{AppThemeBinding Light=#F7F6FA, Dark=#17151E}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252330}" Stroke="{AppThemeBinding Light=#EAE7F0, Dark=#3C3947}" StrokeThickness="1" StrokeShape="RoundRectangle 22" Padding="18">
                <Grid ColumnDefinitions="52,*" ColumnSpacing="14">
                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{AppThemeBinding Light=#EEEAF8, Dark=#343142}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="10">
                        <Image Source="ic_reminder.png" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding TitleText}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#272333, Dark=#F4F1FA}" />
                        <Label Text="{Binding OwnerName}" FontSize="14" TextColor="{AppThemeBinding Light=#777282, Dark=#B6B1C0}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252330}" Stroke="{AppThemeBinding Light=#EAE7F0, Dark=#3C3947}" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="16">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding EnableText}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#272333, Dark=#F4F1FA}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding IsEnabled}" />
                </Grid>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252330}" Stroke="{AppThemeBinding Light=#EAE7F0, Dark=#3C3947}" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding DayOfMonthLabel}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#777282, Dark=#C3BDCD}" />
                    <Border BackgroundColor="{AppThemeBinding Light=#F7F6FA, Dark=#1D1B25}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="8,2">
                        <Picker ItemsSource="{Binding DaysOfMonth}" SelectedItem="{Binding DayOfMonth}" />
                    </Border>
                    <Label Text="{Binding TimeLabel}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#777282, Dark=#C3BDCD}" Margin="0,6,0,0" />
                    <Border BackgroundColor="{AppThemeBinding Light=#F7F6FA, Dark=#1D1B25}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="8,2">
                        <TimePicker Time="{Binding ReminderTime}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252330}" Stroke="{AppThemeBinding Light=#EAE7F0, Dark=#3C3947}" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding RepeatText}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#777282, Dark=#C3BDCD}" />
                    <Border BackgroundColor="{AppThemeBinding Light=#F7F6FA, Dark=#1D1B25}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="8,2">
                        <Picker ItemsSource="{Binding RepeatOptions}" SelectedIndex="{Binding RepeatIndex}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding SaveText}" ImageSource="ic_add.png" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryActionButton}" WidthRequest="280" HorizontalOptions="Center" />
            <Button Text="{Binding CancelText}" Command="{Binding CancelCommand}" Style="{StaticResource LinkActionButton}" WidthRequest="240" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
