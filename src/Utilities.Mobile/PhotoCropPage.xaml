<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Utilities.Mobile.ViewModels"
             x:Class="Utilities.Mobile.PhotoCropPage"
             x:DataType="viewModels:PhotoCropViewModel"
             Title="Reading area"
             BackgroundColor="{AppThemeBinding Light=#F7F6FA, Dark=#17151E}">
    <Grid Padding="16" RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#252330}"
                Stroke="{AppThemeBinding Light=#EAE7F0, Dark=#3C3947}" StrokeThickness="1"
                StrokeShape="RoundRectangle 18" Padding="14">
            <Grid ColumnDefinitions="42,*" ColumnSpacing="12">
                <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{AppThemeBinding Light=#EEEAF8, Dark=#343142}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="8">
                    <Image Source="ic_meter.png" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="{Binding InstructionsTitle}" FontSize="18" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#272333, Dark=#F4F1FA}" />
                    <Label Text="{Binding InstructionsText}" FontSize="12" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#777282, Dark=#B6B1C0}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Border x:Name="ImageFrame" Grid.Row="1" BackgroundColor="{AppThemeBinding Light=White, Dark=#252330}"
                Stroke="{AppThemeBinding Light=#EAE7F0, Dark=#3C3947}" StrokeThickness="1"
                StrokeShape="RoundRectangle 20" Padding="8" IsVisible="{Binding HasPhoto}">
            <Grid x:Name="ImageViewport">
                <Image Source="{Binding CurrentImage}" Aspect="AspectFit" InputTransparent="True" />
                <AbsoluteLayout x:Name="Overlay" InputTransparent="False">
                    <Border x:Name="Selection" Stroke="#35B779" StrokeThickness="3" BackgroundColor="#3035B779"
                            Padding="0" IsVisible="True">
                        <Grid RowDefinitions="*,36">
                            <Border x:Name="MoveSurface" Grid.Row="0" BackgroundColor="Transparent" Padding="0" />
                            <Grid x:Name="ResizeSurface" Grid.Row="1" BackgroundColor="Transparent"
                                  HorizontalOptions="Fill" VerticalOptions="Fill">
                                <Border WidthRequest="48" HeightRequest="5" Margin="0,0,8,5"
                                        HorizontalOptions="End" VerticalOptions="End"
                                        BackgroundColor="#35B779" StrokeThickness="0" StrokeShape="RoundRectangle 3" />
                            </Grid>
                        </Grid>
                    </Border>
                </AbsoluteLayout>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Grid IsVisible="{Binding ShowPhotoChoices}" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="{Binding CameraActionText}" ImageSource="ic_camera.png"
                        Command="{Binding ChoosePhotoCommand}" Style="{StaticResource PrimaryActionButton}" />
                <Button Grid.Column="1" Text="{Binding ChooseGalleryPhotoText}" ImageSource="ic_gallery.png"
                        Command="{Binding ChooseGalleryPhotoCommand}" Style="{StaticResource SecondaryActionButton}" />
            </Grid>

            <Button IsVisible="{Binding HasPhoto}" Text="{Binding CameraActionText}" ImageSource="ic_camera.png"
                    Command="{Binding ChoosePhotoCommand}" Style="{StaticResource SecondaryActionButton}" />
            <Button IsVisible="{Binding HasPhoto}" Text="{Binding RecognizeText}" ImageSource="ic_meter.png"
                    Command="{Binding RecognizeReadingCommand}" IsEnabled="{Binding CanRecognize}"
                    Style="{StaticResource PrimaryActionButton}" />

            <HorizontalStackLayout IsVisible="{Binding IsWorking}" Spacing="10" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsWorking}" Color="#6238D5" VerticalOptions="Center" />
                <Label Text="{Binding WorkingText}" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#777282, Dark=#B6B1C0}" />
            </HorizontalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsRecognitionVisible}" Spacing="6">
                <Label Text="{Binding RecognitionSummaryText}" FontSize="13" LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light=#4D4858, Dark=#D2CEDA}" />
                <Entry Text="{Binding ReadingValue, Mode=TwoWay}" Placeholder="{Binding RecognizeText}"
                       Keyboard="Numeric" ReturnType="Done" ClearButtonVisibility="WhileEditing"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#252330}"
                       TextColor="{AppThemeBinding Light=#272333, Dark=#F4F1FA}" />
                <Button Text="{Binding SaveReadingText}"
                        Command="{Binding SaveReadingCommand}" IsEnabled="{Binding CanSaveReading}"
                        Style="{StaticResource PrimaryActionButton}" />
            </VerticalStackLayout>

            <Button Text="{Binding CancelText}" Command="{Binding CancelCommand}" Style="{StaticResource LinkActionButton}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
