<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Utilities.Mobile.ViewModels"
             x:Class="Utilities.Mobile.PhotoCropPage"
             x:DataType="viewModels:PhotoCropViewModel"
             Title="Reading area"
             BackgroundColor="{AppThemeBinding Light=#F7F6FA, Dark=#17151E}">
    <Grid Padding="8" RowDefinitions="*,Auto" RowSpacing="8">
        <Border x:Name="ImageFrame" Grid.Row="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#252330}"
                Stroke="{AppThemeBinding Light=#EAE7F0, Dark=#3C3947}" StrokeThickness="1"
                StrokeShape="RoundRectangle 18" Padding="4" IsVisible="{Binding HasPhoto}">
            <Grid x:Name="ImageViewport" Grid.RowDefinitions="*,Auto" RowSpacing="4">
                <Image x:Name="PhotoImage" Source="{Binding CurrentImage}" Aspect="AspectFit" InputTransparent="False" />
                <AbsoluteLayout x:Name="Overlay" Grid.Row="0" InputTransparent="False">
                    <Border x:Name="Selection" Stroke="#35B779" StrokeThickness="3" BackgroundColor="#3035B779"
                            Padding="0" IsVisible="True">
                        <Grid>
                            <Border x:Name="MoveSurface" BackgroundColor="Transparent" Padding="0"
                                    HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="False" />
                            <Border x:Name="ResizeSurface" WidthRequest="28" HeightRequest="28"
                                    BackgroundColor="Transparent" Padding="0"
                                    HorizontalOptions="End" VerticalOptions="End" InputTransparent="False">
                                <Border WidthRequest="14" HeightRequest="14" Margin="4"
                                        HorizontalOptions="End" VerticalOptions="End"
                                        BackgroundColor="#35B779" Stroke="#FFFFFF" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 7" />
                            </Border>
                        </Grid>
                    </Border>
                </AbsoluteLayout>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                    <Button Text="−90°" SemanticProperties.Hint="{Binding RotateLeftText}" Command="{Binding RotateLeftCommand}" Style="{StaticResource SecondaryActionButton}" Padding="9,4" HeightRequest="38" />
                    <Slider Grid.Column="1" Minimum="-180" Maximum="180" Value="{Binding RotationDegrees, Mode=TwoWay}"
                            VerticalOptions="Center" MinimumTrackColor="#6238D5" MaximumTrackColor="#C9C3D4" />
                    <Label Grid.Column="2" Text="{Binding RotationText}" FontSize="12" VerticalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#4D4858, Dark=#D2CEDA}" />
                    <Button Grid.Column="3" Text="90°" SemanticProperties.Hint="{Binding RotateRightText}" Command="{Binding RotateRightCommand}" Style="{StaticResource SecondaryActionButton}" Padding="9,4" HeightRequest="38" />
                    <Button Grid.Column="4" Text="↺" SemanticProperties.Hint="{Binding ResetRotationText}" Command="{Binding ResetRotationCommand}" Style="{StaticResource SecondaryActionButton}" Padding="9,4" HeightRequest="38" />
                </Grid>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Grid IsVisible="{Binding ShowPhotoChoices}" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="{Binding CameraActionText}" ImageSource="ic_camera.svg"
                        Command="{Binding ChoosePhotoCommand}" Style="{StaticResource PrimaryActionButton}" />
                <Button Grid.Column="1" Text="{Binding ChooseGalleryPhotoText}" ImageSource="ic_gallery.svg"
                        Command="{Binding ChooseGalleryPhotoCommand}" Style="{StaticResource SecondaryActionButton}" />
            </Grid>

            <Grid IsVisible="{Binding HasPhoto}" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="{Binding CameraActionText}" ImageSource="ic_camera.svg"
                        Command="{Binding ChoosePhotoCommand}" Style="{StaticResource SecondaryActionButton}" Padding="8,4" FontSize="13" />
                <Button Grid.Column="1" Text="{Binding AutoSelectReadingAreaText}" ImageSource="ic_find_digits.svg"
                        Command="{Binding FindReadingAreaCommand}" IsEnabled="{Binding CanRecognize}"
                        Style="{StaticResource SecondaryActionButton}" Padding="8,4" FontSize="13" />
            </Grid>
            <Button IsVisible="{Binding HasPhoto}" Text="{Binding RecognizeText}" ImageSource="ic_meter.svg"
                    Command="{Binding RecognizeReadingCommand}" IsEnabled="{Binding CanRecognize}"
                    Style="{StaticResource PrimaryActionButton}" />

            <HorizontalStackLayout IsVisible="{Binding IsWorking}" Spacing="10" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsWorking}" Color="#6238D5" VerticalOptions="Center" />
                <Label Text="{Binding WorkingText}" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#777282, Dark=#B6B1C0}" />
            </HorizontalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsRecognitionVisible}" Spacing="6">
                <Entry Text="{Binding ReadingValue, Mode=TwoWay}" Placeholder="{Binding RecognizeText}"
                       Keyboard="Numeric" ReturnType="Done" ClearButtonVisibility="WhileEditing"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#252330}"
                       TextColor="{AppThemeBinding Light=#272333, Dark=#F4F1FA}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button ImageSource="ic_save.svg" SemanticProperties.Description="{Binding SaveReadingText}"
                            Command="{Binding SaveReadingCommand}" IsEnabled="{Binding CanSaveReading}"
                            Style="{StaticResource PrimaryActionButton}" HeightRequest="48" />
                    <Button Grid.Column="1" ImageSource="ic_back.svg" SemanticProperties.Description="{Binding CancelText}"
                            Command="{Binding CancelCommand}" Style="{StaticResource SecondaryActionButton}" HeightRequest="48" />
                </Grid>
            </VerticalStackLayout>

            <Button IsVisible="{Binding IsRecognitionNotVisible}"
                    Text="{Binding CancelText}" Command="{Binding CancelCommand}" Style="{StaticResource LinkActionButton}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
