<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Utilities.Mobile.ViewModels"
             x:Class="Utilities.Mobile.ServiceTypesPage"
             x:DataType="viewModels:ServiceTypesViewModel"
             BackgroundColor="{AppThemeBinding Light=#F7F6FA, Dark=#17151E}">
    <ScrollView>
        <VerticalStackLayout Padding="22,18,22,28" Spacing="16">
            <Label Text="{Binding TitleText}" FontSize="30" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#211B31, Dark=#F4F1FA}" />
            <Label Text="{Binding DescriptionText}" TextColor="{AppThemeBinding Light=#777282, Dark=#B6B1C0}" />
            <Button Text="{Binding AddText}" ImageSource="ic_services.png" Command="{Binding AddCommand}" Style="{StaticResource PrimaryActionButton}" />
            <Label Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" TextColor="{AppThemeBinding Light=#777282, Dark=#B6B1C0}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252330}" Stroke="{AppThemeBinding Light=#EAE7F0, Dark=#3C3947}" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="15">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ItemActionsCommand}" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="13">
                                <Border WidthRequest="44" HeightRequest="44" BackgroundColor="{AppThemeBinding Light=#F5F3FA, Dark=#343142}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="9">
                                    <Grid>
                                        <Image Source="{Binding Icon}" IsVisible="{Binding IsBuiltIn}" />
                                        <Label Text="{Binding IconGlyph}" IsVisible="{Binding UsesCustomIcon}" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding DisplayName}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#292535, Dark=#F4F1FA}" />
                                    <Label Text="{Binding CategoryText}" FontSize="12" TextColor="{AppThemeBinding Light=#777282, Dark=#B6B1C0}" />
                                    <Label Text="{Binding DefaultUnit}" IsVisible="{Binding HasDefaultUnit}" FontSize="12" TextColor="{AppThemeBinding Light=#777282, Dark=#B6B1C0}" />
                                    <Label Text="{Binding StatusText}" FontSize="12" TextColor="{AppThemeBinding Light=#777282, Dark=#B6B1C0}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding BuiltInText}" FontSize="10" TextColor="{AppThemeBinding Light=#938AA9, Dark=#B6A9D8}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
