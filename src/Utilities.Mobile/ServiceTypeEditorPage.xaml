<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Utilities.Mobile.ViewModels"
             x:Class="Utilities.Mobile.ServiceTypeEditorPage"
             x:DataType="viewModels:ServiceTypeEditorViewModel"
             Title="New service type"
             BackgroundColor="{AppThemeBinding Light=#F7F6FA, Dark=#17151E}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252330}" Stroke="{AppThemeBinding Light=#ECEAF2, Dark=#3C3947}" StrokeThickness="1" StrokeShape="RoundRectangle 24" Padding="22">
                <VerticalStackLayout Spacing="18">
                    <Image Source="ic_services.png" HeightRequest="52" HorizontalOptions="Start" />
                    <Label Text="{Binding TitleText}" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#201B2B, Dark=#F4F1FA}" />
                    <VerticalStackLayout Spacing="7">
                        <Label Text="{Binding IconLabel}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#454150, Dark=#E3DFEA}" />
                        <CollectionView ItemsSource="{Binding IconOptions}" SelectionMode="None" HeightRequest="328">
                            <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="5" HorizontalItemSpacing="8" VerticalItemSpacing="8" /></CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ServiceIconOption">
                                    <Border HeightRequest="48" WidthRequest="48" Padding="4" BackgroundColor="{AppThemeBinding Light=#F5F3FA, Dark=#343142}" Stroke="{AppThemeBinding Light=#EAE7F0, Dark=#3C3947}" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light=#5632D4, Dark=#B69CFF}" />
                                                <Setter Property="StrokeThickness" Value="3" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectIconCommand}" CommandParameter="{Binding Key}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Glyph}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="7">
                        <Label Text="{Binding NameLabel}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#454150, Dark=#E3DFEA}" />
                        <Entry Text="{Binding Name}" Placeholder="{Binding NamePlaceholder}" ReturnType="Next" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="7">
                        <Label Text="{Binding CategoryLabel}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#454150, Dark=#E3DFEA}" />
                        <Picker ItemsSource="{Binding CategoryOptions}" SelectedIndex="{Binding CategoryIndex}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="7" IsVisible="{Binding IsMeterBased}">
                        <Label Text="{Binding UnitLabel}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#454150, Dark=#E3DFEA}" />
                        <Entry Text="{Binding DefaultUnit}" Placeholder="{Binding UnitPlaceholder}" ReturnType="Done" />
                    </VerticalStackLayout>
                    <Button Text="{Binding SaveText}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryActionButton}" />
                    <Button Text="{Binding CancelText}" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryActionButton}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
